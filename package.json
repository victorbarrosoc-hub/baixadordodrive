{
  "name": "sobedesce",
  "version": "0.1.0",
  "description": "SOBEDESCE — transferências rápidas e retomáveis para o Google Drive, feitas para arquivos gigantes de audiovisual.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "SOBEDESCE",
  "homepage": "https://github.com/victorbarrosoc-hub/baixadordodrive",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20.18"
  },
  "bin": {
    "sobedesce": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "demo": "node scripts/demo.js",
    "desktop": "electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:fast": "node --test --test-concurrency=1 --test-skip-pattern=slow \"test/*.test.js\""
  },
  "dependencies": {
    "htm": "^3.1.1",
    "preact": "^10.27.0",
    "qrcode-generator": "2.0.4",
    "undici": "^7.16.0",
    "xxhash-wasm": "1.1.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.30.0"
  }
}
