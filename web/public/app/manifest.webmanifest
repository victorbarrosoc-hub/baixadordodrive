{
  "id": "/app/",
  "name": "SOBEDESCE",
  "short_name": "SOBEDESCE",
  "description": "Envie vídeos e arquivos do celular direto para o seu Google Drive.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/app/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#f2f2f6",
  "background_color": "#f2f2f6",
  "user_preferences": {
    "color_scheme_dark": {
      "theme_color": "#0b0b0c",
      "background_color": "#0b0b0c"
    }
  },
  "categories": [
    "productivity",
    "utilities"
  ],
  "share_target": {
    "action": "/app/?compartilhar=1",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "/app/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/app/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
