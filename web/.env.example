# Copie para .env.local. Sem DATABASE_URL o site usa o PGlite em ./data/pglite.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32
SOBEDESCE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# E-mail transacional (Resend). Sem chave: em dev o e-mail aparece no console; em produção "Esqueci a senha" fica indisponível.
RESEND_API_KEY=
EMAIL_REMETENTE=SOBEDESCE <nao-responda@dissesim.com.br>
